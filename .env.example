# Application port
PORT=3000

# Local SQL Server connection
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=HotelNT;encrypt=true;trustServerCertificate=true
DB_USER=sa
DB_PASSWORD=

# SQL Server Docker container
MSSQL_SA_PASSWORD=

# SMTP settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Comma-separated allowed browser origins
CORS_ORIGINS=*

# Public API origin used to build absolute image URLs in chatbot responses
APP_PUBLIC_BASE_URL=https://your-domain.example.com

# Optional Google Maps API key
GOOGLE_MAPS_API_KEY=

# Optional DeepSeek API key for natural-language chatbot replies (platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# JWT: chuoi bi mat ky token, BAT BUOC tu 32 ky tu tro len.
APP_AUTH_JWT_SECRET=

# Thu muc luu anh upload
APP_UPLOAD_DIR=uploads