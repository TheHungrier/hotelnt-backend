MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Comma-separated allowed browser origins
CORS_ORIGINS=*

# Optional Google Maps API key
GOOGLE_MAPS_API_KEY=
