PORT=3000

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=HotelNT;encrypt=true;trustServerCertificate=true
DB_USER=sa
DB_PASSWORD=

MSSQL_SA_PASSWORD=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

CORS_ORIGINS=*

APP_PUBLIC_BASE_URL=

GOOGLE_MAPS_API_KEY=

# Cấu hình AI Provider cho Chatbot: cloudflare | gemini | none (mặc định: none)
AI_PROVIDER=none

# Cloudflare Workers AI (khi AI_PROVIDER=cloudflare)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Google Gemini (khi AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: trỏ sang reverse proxy/Cloudflare Worker nếu deploy server ở Hong Kong
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# JWT: chuoi bi mat ky token, BAT BUOC tu 32 ky tu tro len.
APP_AUTH_JWT_SECRET=

# Thu muc luu anh upload
APP_UPLOAD_DIR=uploads
